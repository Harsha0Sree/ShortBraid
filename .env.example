# =============================================================
# 12-Factor Config — All environment variables live here.
# Copy to `.env` and override. NEVER hardcode in source.
# =============================================================

# --- App ---
APP_ENV=development
APP_NAME=headroom-ccr
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=headroom
POSTGRES_PASSWORD=headroom_secret
POSTGRES_DB=headroom
PG_POOL_MIN=5
PG_POOL_MAX=20

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
RATE_LIMIT_RPM=5
CACHE_TTL_SECONDS=3600

# --- MinIO (S3-compatible) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=headroom-ingest
MINIO_SECURE=false
MINIO_REGION=us-east-1

# --- OpenAI ---
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3

# --- Worker (arq) ---
WORKER_CONCURRENCY=10
WORKER_MAX_JOBS=50

# --- LLM cost (USD per 1K tokens, gpt-4o-mini pricing) ---
COST_INPUT_PER_1K=0.000150
COST_OUTPUT_PER_1K=0.000600
